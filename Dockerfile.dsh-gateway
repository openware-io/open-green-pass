# GreenPass DSH SDK gateway image.
# The gateway binary is prebuilt by scripts/dev/deploy-kind.ps1; this image adds
# Node.js + the DSH CLI so the SDK runner can execute real DSH sessions.
FROM node:22-bookworm-slim

RUN npm install -g @deepseek-ai/dsh@0.2.1-rc.2

COPY dsh-gateway-linux /usr/local/bin/dsh-gateway
RUN chmod +x /usr/local/bin/dsh-gateway

ENV HOME=/tmp
ENV GP_DSH_BINARY=/usr/local/bin/dsh
ENV GP_DSH_PROFILE=sdk
ENV GP_DSH_RUNNER=sdk

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/dsh-gateway"]

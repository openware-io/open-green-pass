FROM node:24-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_GP_API_BASE=/api
ARG VITE_GP_TEAM_ID=1001
ARG VITE_GP_USER_ID=42
ENV VITE_GP_API_BASE=$VITE_GP_API_BASE
ENV VITE_GP_TEAM_ID=$VITE_GP_TEAM_ID
ENV VITE_GP_USER_ID=$VITE_GP_USER_ID
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
# The repository's Vite plugin emits the application shell to dist/output and
# its browser assets to dist/output_resource. Merge both produced directories
# into nginx's static root; copying only the shell leaves /assets requests
# broken in a real deployment.
COPY --from=build /src/dist/output /usr/share/nginx/html
COPY --from=build /src/dist/output_resource/assets /usr/share/nginx/html/assets
COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080

# GP0-03 本地开发端口契约（宿主机避让 im-saas）。
# im-saas 占用宿主常见端口（5432/6379/9000 等），GP 基础依赖映射到以下端口。
# 说明：.env 为本地开发配置，勿提交密钥；GP_MINIO_SECRET 为本地调试值。
GP_ENV=dev
GP_ADDR=:8080
# 浏览器前端来源白名单（逗号分隔；不使用 *，因为 API 带租户/用户请求头）
GP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL（gp 命名空间内 svc/gp-postgres，宿主机映射 5433）
GP_DB_DSN=postgres://gp:gp@127.0.0.1:5433/gp?sslmode=disable

# Redis（映射 6380，避让 im 6379）
GP_REDIS_ADDR=127.0.0.1:6380

# Temporal（映射 7233；Web UI 宿主机 8080 被 GP_ADDR 占用，改 8082）
GP_TEMPORAL_ADDR=127.0.0.1:7233
GP_TEMPORAL_UI=127.0.0.1:8082

# 对象存储（S3 兼容）：MinIO 社区版已归档(410 Gone)，本地用 SeaweedFS（svc/gp-seaweedfs，宿主机映射 9100 S3 API）。
# SeaweedFS 无独立 console（9101 端口移除）；S3 凭证 GP_MINIO_KEY/SECRET 为 GP 侧 S3 client 使用的本地值。
GP_MINIO_ENDPOINT=127.0.0.1:9100
GP_MINIO_KEY=gpminio
GP_MINIO_SECRET=gpminio-secret
